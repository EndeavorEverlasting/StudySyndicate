# Sanitized generated-looking fixtures remain trackable when explicitly named
!fixtures/**/*.fixture.log
!tests/fixtures/**/*.fixture.log
!docs/fixtures/**/*.fixture.log
!fixtures/**/*.fixture.dmp
!tests/fixtures/**/*.fixture.dmp
!docs/fixtures/**/*.fixture.dmp
