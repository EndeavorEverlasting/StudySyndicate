{
  "schema": "study-syndicate/artifact-registry/v1",
  "naming": {
    "trackedContract": "<domain>-<purpose>.v<major>.json",
    "operatorReport": "harness/reports/<UPPER_SNAKE_NAME>.md",
    "localSession": "local-study-exports/session-YYYYMMDD-HHMM-<track>.json",
    "learningEvent": "local-study-exports/learning-event-YYYYMMDD-HHMM-<concept>.json",
    "studyGuidance": "local-study-exports/study-guidance-YYYYMMDD-HHMM-<origin>.json",
    "sourceImport": "local-study-exports/youtube-<input-kind>-<source-id>.json",
    "sourceImportCsv": "local-study-exports/youtube-<input-kind>-<source-id>.csv",
    "mediaBundle": "media-bundles/<study-id>-YYYYMMDD.study-media.zip",
    "promotionReceipt": "GitHub Actions artifact promotion-receipt/promotion-receipt.json"
  },
  "artifacts": [
    {"id":"practice-workbench-build","kind":"ignored-build-artifact","path":"dist/","source":"src/ + harness/practice-workbench.v1.json + canonical study packs","generate":["npm","run","build"],"validate":["npm","run","build"]},
    {"id":"canonical-path-contract","kind":"tracked-contract","path":"harness/canonical-paths.v1.json","source":"machine/profile-aware development/use/worktree location authority","generate":null,"validate":["python","scripts/validate-canonical-paths.py"]},
    {"id":"repo-location-proof","kind":"operator-terminal-proof","path":"stdout","source":"harness/canonical-paths.v1.json + OS/profile inputs + canonical Git origin","generate":["pwsh","-NoLogo","-NoProfile","-File","scripts/Resolve-StudySyndicateRepo.ps1","-Json"],"validate":["python","scripts/validate-canonical-paths.py"]},
    {"id":"promotion-contract","kind":"tracked-contract","path":"harness/promotion-contract.v1.json","source":"exact-candidate main promotion authority","generate":null,"validate":["python","scripts/validate-promotion.py"]},
    {"id":"application-e2e-proof","kind":"provider-runtime-artifact","path":"GitHub Actions artifact: application-e2e-proof/application-e2e.json","source":"exact candidate dist/ served through npm run preview","generate":["python","scripts/application-e2e.py","--receipt",".promotion/application-e2e.json"],"validate":["python","scripts/validate-promotion.py"]},
    {"id":"promotion-receipt","kind":"provider-runtime-artifact","path":"GitHub Actions artifact: promotion-receipt/promotion-receipt.json","source":".github/workflows/promote-main.yml exact candidate, required gates, merge response, and containment proof","generate":".github/workflows/promote-main.yml","validate":["python","scripts/validate-promotion.py"]},
    {"id":"parallaxport-study-fodder","kind":"tracked-report","path":"harness/reports/PARALLAXPORT_STUDY_FODDER.md","source":"harness/sources/parallaxport-claims.v1.json","generate":["python","scripts/harness.py","study-fodder"],"validate":["python","scripts/harness.py","study-fodder","--check"]},
    {"id":"harness-state","kind":"tracked-report","path":"harness/reports/STATE.md","generate":null,"validate":["python","scripts/validate-harness.py"]},
    {"id":"learning-evidence-contract","kind":"tracked-contract","path":"content/learning/learning-evidence.v1.json","source":"docs/LEARNING_EVIDENCE_DOCTRINE.md","generate":null,"validate":["python","scripts/learning-evidence.py","validate-contract"]},
    {"id":"learning-evidence-state","kind":"tracked-report","path":"harness/reports/LEARNING_EVIDENCE_STATE.md","source":"content/learning/learning-evidence.v1.json","generate":null,"validate":["python","tests/test_learning_evidence_engine.py"]},
    {"id":"learning-event-score","kind":"operator-terminal-artifact","path":"stdout","source":"local learning-event JSON + content/learning/learning-evidence.v1.json","generate":["python","scripts/learning-evidence.py","score","PATH_TO_EVENT.json"],"validate":["python","tests/test_learning_evidence_engine.py"]},
    {"id":"study-guidance-contract","kind":"tracked-contract","path":"content/learning/study-guidance.v1.json","source":"harness/workflows/STUDY_GUIDANCE_INGEST.md","generate":null,"validate":["python","scripts/study-guidance.py","validate-contract"]},
    {"id":"study-guidance-derived-material","kind":"operator-terminal-artifact","path":"stdout","source":"local study guidance JSON + content/learning/study-guidance.v1.json","generate":["python","scripts/study-guidance.py","derive","PATH_TO_PACKET.json"],"validate":["python","tests/test_study_guidance.py"]},
    {"id":"source-import-contract","kind":"tracked-contract","path":"content/learning/source-import.v1.json","source":"harness/sources/youtube-playlist-donor.v1.json","generate":null,"validate":["python","scripts/validate-source-ingestion.py"]},
    {"id":"youtube-source-import-json","kind":"ignored-operator-artifact","path":"local-study-exports/youtube-<input-kind>-<source-id>.json","source":"yt-dlp output normalized by scripts/source-ingest-youtube.py","generate":"python scripts/source-ingest-youtube.py <one-or-more YouTube URLs>","validate":["python","tests/test_youtube_source_ingestion.py"]},
    {"id":"youtube-source-import-csv","kind":"ignored-operator-artifact","path":"local-study-exports/youtube-<input-kind>-<source-id>.csv","source":"projection of study-syndicate/source-import/v1 JSON occurrences","generate":"python scripts/source-ingest-youtube.py <one-or-more YouTube URLs>","validate":["python","tests/test_youtube_source_ingestion.py"]},
    {"id":"arrays-reference","kind":"tracked-reference","path":"practice/arrays/two_sum.py","generate":null,"validate":["python","tests/test_two_sum.py"]},
    {"id":"software-foundations-pack","kind":"tracked-contract","path":"content/software/sql-rust-foundations.v1.json","generate":null,"validate":["python","scripts/validate-software-foundations.py"]},
    {"id":"arrays-mastery-pack","kind":"tracked-contract","path":"content/software/arrays-mastery.v1.json","generate":null,"validate":["python","scripts/validate-arrays-mastery.py"]},
    {"id":"media-contract","kind":"tracked-contract","path":"content/media/multimodal-media-contract.v1.json","generate":null,"validate":["python","scripts/validate-multimodal-media.py"]},
    {"id":"local-study-session","kind":"ignored-operator-artifact","path":"local-study-exports/session-YYYYMMDD-HHMM-<track>.json","generate":"operator/session workflow","validate":"track-specific validator plus recorded evidence"},
    {"id":"local-learning-event","kind":"ignored-operator-artifact","path":"local-study-exports/learning-event-YYYYMMDD-HHMM-<concept>.json","generate":"harness/workflows/LEARNING_EVENT_CASCADE.md","validate":["python","scripts/learning-evidence.py","score","PATH_TO_EVENT.json"]},
    {"id":"local-study-guidance","kind":"ignored-operator-artifact","path":"local-study-exports/study-guidance-YYYYMMDD-HHMM-<origin>.json","generate":"harness/workflows/STUDY_GUIDANCE_INGEST.md","validate":["python","scripts/study-guidance.py","validate","PATH_TO_PACKET.json"]},
    {"id":"portable-media-bundle","kind":"ignored-binary-artifact","path":"media-bundles/<study-id>-YYYYMMDD.study-media.zip","generate":["python","scripts/media-bundle.py","pack"],"validate":["python","scripts/media-bundle.py","validate"]}
  ]
}
